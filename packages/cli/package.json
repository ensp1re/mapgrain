{
  "name": "mapgrain",
  "version": "0.2.2",
  "description": "Local-first CLI for architecture, workflow, sequence, data-flow, and lifecycle diagrams.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mapgrain": "./dist/mapgrain.js"
  },
  "files": [
    "dist",
    "schema",
    "examples",
    "studio",
    "fonts",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ensp1re/mapgrain.git"
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "prepack": "pnpm build",
    "test": "node --test --experimental-strip-types --test-reporter=spec tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "elkjs": "^0.10.0"
  },
  "devDependencies": {
    "@mapgrain/document": "workspace:*",
    "@mapgrain/layout": "workspace:*",
    "@mapgrain/scene": "workspace:*",
    "@mapgrain/renderer": "workspace:*",
    "@mapgrain/viewer": "workspace:*",
    "esbuild": "^0.25.9"
  }
}
