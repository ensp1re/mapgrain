      "groupId": null,
      "ports": []
    },
    {
      "id": "resolved",
      "kind": "state",
      "label": "Resolved",
      "groupId": null,
      "ports": []
    },
    {
      "id": "closed",
      "kind": "state",
      "label": "Closed",
      "groupId": null,
      "ports": [],
